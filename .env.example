# Copy to .env.local and fill in. .env.local is gitignored — never commit keys.
OPENAI_API_KEY=
OCTEN_API_KEY=
COMPOSIO_API_KEY=
# Composio user id whose Slack connected account is used (see Composio dashboard)
COMPOSIO_USER_ID=default
# Slack channel the ship brief posts to
SLACK_CHANNEL=#backtalk-demo
# Optional fallback if Composio Slack isn't connected: raw incoming webhook URL
SLACK_WEBHOOK_URL=

# replay = re-emit fixtures/cache/events.jsonl (demo mode, no keys needed)
# live   = run the real pipeline and refresh the cache
DEMO=live
# multiplier on replay pacing delays (0.5 = twice as fast)
REPLAY_SPEED=1
